<odoo>
<!-- Workflow -->
<record id="project_milestone_viewer_group" model="res.groups">
    <field name="name">Viewer</field>
    <field name="category_id" ref="project_milestone_workflow_module_category" />
</record>

<record id="project_milestone_user_group" model="res.groups">
    <field name="name">User</field>
    <field name="category_id" ref="project_milestone_workflow_module_category" />
    <field name="implied_ids" eval="[(4, ref('project_milestone_viewer_group'))]" />
</record>

<record id="project_milestone_validator_group" model="res.groups">
    <field name="name">Validator</field>
    <field name="category_id" ref="project_milestone_workflow_module_category" />
    <field name="implied_ids" eval="[(4, ref('project_milestone_user_group'))]" />
    <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
</record>
</odoo>

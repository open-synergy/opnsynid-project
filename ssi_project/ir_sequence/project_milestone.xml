<odoo>
<record id="sequence_project_milestone" model="ir.sequence">
    <field name="name">Project Milestone</field>
    <field name="code">project.milestone</field>
    <field name="padding">6</field>
    <field name="prefix">PM/%(range_year)s/</field>
    <field eval="1" name="number_next" />
    <field eval="1" name="number_increment" />
    <field name="use_date_range" eval="1" />
</record>
</odoo>
